# ---------------------------------------------------------------------------
# شبيبة ستور — environment template.
# Copy to `.env` and fill in. Never commit `.env` itself (Part II 5: secrets).
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
LOG_JSON=false                       # true in production: structured logs (Part II 5)

# --- Database ---
# SQLite for now, schema kept portable to PostgreSQL (Part II 1).
DATABASE_URL=sqlite:///./data/jec_store.db
# Develop against PostgreSQL before launch — SQLite locking differs (Part II 7.4):
# DATABASE_URL=postgresql+psycopg://jec:jec@localhost:5432/jec_store
DATABASE_ECHO=false

# --- Sessions (server-side, Redis-backed — Part II 7.4) ---
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_NAME=jec_session
SESSION_COOKIE_SECURE=false          # true behind HTTPS
SESSION_IDLE_TIMEOUT_MINUTES=120     # global default; per-role override lives in DB (Part I 2.3)

# --- Localisation ---
DEFAULT_LANGUAGE=ar                  # ar | en
DEFAULT_CURRENCY=JOD                 # JOD | USD
NUMERAL_SYSTEM=western               # western | arabic-indic (Part I 17.2 — decided once, site-wide)
DEFAULT_USD_RATE=1.41                # seed value only; live rate lives in SCD_EXCHANGE_RATE

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_TRANSPORT=console          # console | smtp — use smtp in staging/production
MAIL_FROM=no-reply@jecjordan.com
MAIL_FROM_NAME=شبيبة ستور

# --- Abuse protection (Part I 2.4) ---
CAPTCHA_PROVIDER=none                # none | turnstile | recaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_FAILED_ATTEMPTS_THRESHOLD=3  # challenge only after repeated failures, not every request
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=15

# --- Search (Part II 7.4) ---
SEARCH_BACKEND=sql                   # sql | meilisearch | typesense
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Uploads ---
MEDIA_ROOT=./media
MEDIA_URL=/media
MAX_UPLOAD_MB=10
